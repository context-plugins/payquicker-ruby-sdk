#!/usr/bin/env ruby

# Load the lib folder into Ruby's load path
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

# Require the gem
require 'pq_api_v2'

puts 'PqApiV2 SDK loaded!'
puts 'You can now create a client with: client = PqApiV2::Client.new'
puts 'Or use from_env: client = PqApiV2::Client.from_env'

# Start an interactive IRB session
require 'irb'
IRB.start
